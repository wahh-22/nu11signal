#!/usr/bin/env bash
# Test stub: `go build ... -ldflags "... -X main.version=V" -o OUT PKG`.
# For GOOS=linux it writes a fake ELF to OUT: a 64-bit little-endian header
# whose machine matches GOARCH (amd64: x86_64, arm64: aarch64), followed by
# "version=V". Otherwise it writes a script that prints V for --version.
# STUB_GO_WRONG_ARCH=1 swaps the ELF machine (an arm64 build comes out x86_64).
# STUB_GO_ELF_TYPE=N sets the ELF e_type (default 2, ET_EXEC; 3 is ET_DYN).
# STUB_GO_VERSION_PREFIX and STUB_GO_VERSION_SUFFIX are stamped around V.
# Calls are logged as "go GOOS=.. GOARCH=.. CGO_ENABLED=.. ARGS".
echo "go GOOS=${GOOS:-} GOARCH=${GOARCH:-} CGO_ENABLED=${CGO_ENABLED:-} $*" >>"$STUB_LOG"
[[ "${1:-}" == build ]] || { echo "go stub: unsupported: $*" >&2; exit 1; }
out="" version=dev prev=""
for arg in "$@"; do
  [[ "$prev" == -o ]] && out="$arg"
  if [[ "$arg" == *main.version=* ]]; then
    version="${arg##*main.version=}"
    version="${version%% *}"
  fi
  prev="$arg"
done
[[ -n "$out" ]] || { echo "go stub: no -o" >&2; exit 1; }
if [[ "${GOOS:-}" == linux ]]; then
  arch="${GOARCH:-}"
  if [[ "${STUB_GO_WRONG_ARCH:-0}" == 1 ]]; then
    case "$arch" in amd64) arch=arm64 ;; arm64) arch=amd64 ;; esac
  fi
  case "$arch" in
    amd64) machine='\076\000' ;;
    arm64) machine='\267\000' ;;
    *) echo "go stub: unsupported GOARCH: ${GOARCH:-}" >&2; exit 1 ;;
  esac
  {
    printf '\177ELF\002\001\001\000\000\000\000\000\000\000\000\000'
    printf "\\00${STUB_GO_ELF_TYPE:-2}\\000"
    printf "$machine"
    printf '\nversion=%s%s%s\n' "${STUB_GO_VERSION_PREFIX:-}" "$version" "${STUB_GO_VERSION_SUFFIX:-}"
  } >"$out"
else
  printf '#!/bin/sh\necho %s\n' "$version" >"$out"
fi
chmod +x "$out"
