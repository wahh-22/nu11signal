# Homebrew cask for soul-king. Copy to Casks/soul-king.rb in a tap, then
# replace __VERSION__ and __SHA256__ with the release version (no "v") and
# the digest from dist/soul-king-<version>-macos-universal.tar.gz.sha256.
#
# Homebrew symlinks bin/soul-king into its prefix; soul-king resolves the
# symlink and finds the helper in the archive's ../libexec.
cask "soul-king" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/wahh-22/soul-king/releases/download/v#{version}/soul-king-#{version}-macos-universal.tar.gz"
  name "soul-king"
  desc "Cyberpunk-style terminal radio for Apple Music"
  homepage "https://github.com/wahh-22/soul-king"

  depends_on macos: ">= :sonoma"

  binary "soul-king-#{version}/bin/soul-king"

  caveats <<~EOS
    soul-king requires an Apple Music subscription.
    The first launch asks for access to Apple Music; if it was denied, enable
    SoulKingHelper in System Settings > Privacy & Security > Media & Apple Music.
  EOS
end
